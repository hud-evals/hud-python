# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bubblewrap git util-linux \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /hud
COPY pyproject.toml uv.lock env.py grader.py flask.bundle ./

COPY .hud-sdk/ .hud-sdk/
ARG HUD_SDK_VERSION=0.6.19
RUN UV_PROJECT_ENVIRONMENT=/usr/local/venv uv sync --frozen --no-install-project \
  && /usr/local/venv/bin/python -c "from importlib.metadata import version; import os; assert version('hud') == os.environ['HUD_SDK_VERSION']; print('HUD_SDK_VERSION=' + version('hud'))" \
  && mkdir /app \
  && chown 1000:1000 /app \
  && chmod -R a+rX /usr/local/venv \
  && chmod -R go-rwx /hud

ENV PATH="/usr/local/venv/bin:${PATH}" REPO_DIR=/app
EXPOSE 8765
CMD ["hud", "serve", "/hud/env.py", "--host", "0.0.0.0", "--port", "8765"]
