# syntax=docker/dockerfile:1
FROM python:3.12-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.8.24 /uv /uvx /bin/

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

RUN apt-get update \
 && apt-get install -y --no-install-recommends bubblewrap ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --uid 1000 --no-create-home --home-dir /workspace --shell /bin/bash agent \
 && mkdir -p /workspace && chown agent:agent /workspace

COPY . .
RUN set -eu; \
    if [ -d .hud-sdk ]; then \
        set -- .hud-sdk/hud-*.whl; \
        test "$#" -eq 1; \
        test -f "$1"; \
        uv add --no-sync "$1"; \
    fi; \
    uv sync --upgrade-package hud --no-dev; \
    uv export --only-group agent-tools --no-hashes --no-emit-project -o /tmp/agent-tools.txt; \
    uv pip install --system --python /usr/local/bin/python3 --no-cache -r /tmp/agent-tools.txt; \
    rm /tmp/agent-tools.txt

EXPOSE 8765
CMD ["hud", "serve", "env:env", "--host", "0.0.0.0", "--port", "8765"]
