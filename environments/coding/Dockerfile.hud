# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git util-linux \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /hud
COPY pyproject.toml uv.lock env.py flask.bundle ./
COPY coding coding

RUN UV_PROJECT_ENVIRONMENT=/usr/local/venv uv sync --frozen --no-install-project \
  && git -c init.defaultBranch=main clone -q flask.bundle /app \
  && uv pip install --python /usr/local/venv/bin/python --no-deps -e /app \
  && chown -R 1000:1000 /app \
  && chmod -R a+rX /usr/local/venv \
  && chmod -R go-rwx /hud

ENV PATH="/usr/local/venv/bin:${PATH}" REPO_DIR=/app
EXPOSE 8765
CMD ["hud", "serve", "/hud/env.py", "--host", "0.0.0.0", "--port", "8765"]
