# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bubblewrap git util-linux \
  && rm -rf /var/lib/apt/lists/*

# Temporary: Claude Code, for `hud eval ... claude`, until runtimes supply the agent CLI to
# environments themselves.
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) platform=linux-x64 sum=b6b3647d981130dc44fc670846ae97b6cde531ffb667cf9c4d17cfcafb38cb37 ;; \
      arm64) platform=linux-arm64 sum=98d56f6ffe53469767a74864a38eaf359d62ef557a8de1b1ad524d61a66ec119 ;; \
      *) echo "no Claude Code build for architecture '$TARGETARCH'" >&2; exit 1 ;; \
    esac \
  && python3 -c "import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])" \
    "https://downloads.claude.ai/claude-code-releases/2.1.326/$platform/claude" /usr/local/bin/claude \
  && echo "$sum  /usr/local/bin/claude" | sha256sum -c - \
  && chmod 755 /usr/local/bin/claude

WORKDIR /hud
COPY pyproject.toml uv.lock env.py grader.py flask.bundle ./

RUN UV_PROJECT_ENVIRONMENT=/usr/local/venv uv sync --frozen --no-install-project \
  && mkdir /app \
  && chown 1000:1000 /app \
  && chmod -R a+rX /usr/local/venv \
  && chmod -R go-rwx /hud

ENV PATH="/usr/local/venv/bin:${PATH}" REPO_DIR=/app
EXPOSE 8765
CMD ["hud", "serve", "/hud/env.py", "--host", "0.0.0.0", "--port", "8765"]
