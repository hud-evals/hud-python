FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap chromium chromium-sandbox dbus-x11 supervisor util-linux x11vnc xfce4 xvfb \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 --user-group ubuntu \
    && install -d -o ubuntu -g ubuntu /home/ubuntu/Desktop /home/ubuntu/Downloads /workspace \
    && install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix

WORKDIR /app
COPY requirements.txt ./
ARG HUD_SDK_VERSION=0.6.20
RUN uv pip install --system --no-cache --require-hashes -r requirements.txt \
    && python3 -c "from importlib.metadata import version; import os; assert version('hud') == os.environ['HUD_SDK_VERSION']; print('HUD_ENV_SDK_VERSION=' + version('hud'))"
COPY env.py grader.py supervisord.conf ./
RUN chmod -R go-rwx /app

ENV DISPLAY=:1 PYTHONDONTWRITEBYTECODE=1 NO_AT_BRIDGE=1
EXPOSE 8765
CMD ["supervisord", "-c", "/app/supervisord.conf"]
