FROM mcr.microsoft.com/playwright/python:v1.63.0-noble@sha256:72bd171a9ffc2b4b59532aaa6210e21014d07093120dc25528870c0b840da1f0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap util-linux nodejs && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
ARG HUD_SDK_VERSION=0.6.20
RUN python3 -m pip install --no-cache-dir --require-hashes -r requirements.txt \
    && python3 -c "from importlib.metadata import version; import os; assert version('hud') == os.environ['HUD_SDK_VERSION']; assert version('playwright') == '1.63.0'; print('HUD_ENV_SDK_VERSION=' + version('hud'))"
COPY env.py grader.py motion.py viewer.html ./
COPY starter ./starter
RUN chmod -R go-rwx /app && mkdir -p /workspace && chown 1000:1000 /workspace
ENV WORKSPACE_DIR=/workspace PYTHONDONTWRITEBYTECODE=1
EXPOSE 8765
CMD ["hud", "serve", "env:env", "--host", "0.0.0.0", "--port", "8765"]
