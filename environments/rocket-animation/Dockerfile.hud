FROM mcr.microsoft.com/playwright/python:v1.63.0-noble@sha256:72bd171a9ffc2b4b59532aaa6210e21014d07093120dc25528870c0b840da1f0
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade ca-certificates \
    && apt-get install -y --no-install-recommends bubblewrap git util-linux nodejs \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app/
RUN set -eu; \
    python3 -m pip install --no-cache-dir --require-hashes -r requirements.txt; \
    if [ -d .hud-sdk ]; then \
        set -- .hud-sdk/hud-*.whl; test "$#" -eq 1; test -f "$1"; \
        python3 -m pip install --no-cache-dir "$1"; \
    else \
        python3 -m pip install --no-cache-dir "hud @ git+https://github.com/hud-evals/hud-python.git@main"; \
    fi
RUN chmod -R go-rwx /app && mkdir -p /workspace && chown 1000:1000 /workspace
ENV WORKSPACE_DIR=/workspace PYTHONDONTWRITEBYTECODE=1
EXPOSE 8765
CMD ["hud", "serve", "env:env", "--host", "0.0.0.0", "--port", "8765"]
