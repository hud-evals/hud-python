{
  "docker": [
    {
      "argv": "version --format {{.Server.Version}}"
    },
    {
      "argv": "compose --project-name hud-adapt-missing --project-directory <case>/task-a/environment --file <resolve>/compose.json --file <resolve>/override.json pull main",
      "files": {
        "compose.json": {
          "networks": {},
          "services": {
            "main": {
              "environment": {},
              "expose": [],
              "ports": [],
              "volumes": []
            }
          }
        },
        "override.json": {
          "services": {
            "main": {
              "image": "registry.example/base:latest"
            }
          }
        }
      }
    },
    {
      "argv": "image inspect registry.example/base:latest"
    }
  ],
  "failures": [],
  "projects": {
    "prebuilt-image-<h1>": {
      "compose.yaml": {
        "networks": {},
        "services": {
          "main": {
            "build": {
              "args": {
                "BASE_IMAGE": "registry.example/base:latest",
                "HUD_REQUIREMENT": "hud",
                "VERIFIER_IMAGE": "registry.example/base:latest"
              },
              "context": "./compose-project/main",
              "target": "plain"
            },
            "command": [
              "/controller/venv/bin/hud",
              "serve",
              "hud.integrations.harbor.env:env",
              "--host",
              "0.0.0.0",
              "--port",
              "8765"
            ],
            "entrypoint": [],
            "environment": {},
            "expose": [],
            "image": "hud-harbor:prebuilt-image-<h1>-<h2>",
            "ports": [],
            "volumes": [
              "./compose-project/tests:/controller/tests:ro"
            ]
          }
        }
      },
      "tasks.json": [
        {
          "args": {
            "instruction": "Solve the task.\n",
            "task": {
              "artifacts": [],
              "collect": [],
              "description": "",
              "id": "task-a",
              "separate_verifier": false,
              "verifier_timeout": 600.0
            }
          },
          "env": "prebuilt-image-<h1>",
          "id": "run",
          "runtime_config": {
            "compose": {
              "document": "compose.yaml",
              "root": ".",
              "service_access": null
            },
            "limits": null,
            "resources": null
          },
          "slug": "task-a"
        }
      ],
      "tree": [
        "compose-project/main/Dockerfile",
        "compose-project/main/config.json",
        "compose-project/main/install.sh",
        "compose-project/tests/task-a/test.sh",
        "compose.yaml",
        "env.py",
        "tasks.json"
      ]
    }
  }
}